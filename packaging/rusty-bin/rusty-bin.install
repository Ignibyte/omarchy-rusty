post_install() {
  cat <<'MSG'
  Rusty: start the back end as your user (not as root):
      systemctl --user daemon-reload
      systemctl --user enable --now rusty-mcp
  Agents: add {"rusty": {"type": "stdio", "command": "rusty-mcp"}} to your MCP config
  (see /usr/share/rusty/mcp-config.json).
MSG
}
post_upgrade() {
  # pacman runs this as root, which cannot reach a user's service manager.
  cat <<'MSG'
  Rusty: restart the back end as your user to run the new build:
      systemctl --user daemon-reload
      systemctl --user restart rusty-mcp
  Agents' own rusty-mcp servers keep the old build until the agent restarts.
MSG
}
